{
  "name": "ptcg-sim",
  "version": "1.0.0",
  "description": "Simulatore Pokémon TCG per preparare i tornei",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo": "tsx src/tools/demo.ts",
    "import-cards": "NODE_USE_ENV_PROXY=1 tsx src/tools/import-cards.ts",
    "check-decks": "tsx src/tools/check-decks.ts",
    "coverage": "tsx src/tools/coverage.ts",
    "matrix": "tsx src/tools/matrix.ts",
    "replay": "tsx src/tools/replay.ts",
    "import-limitless": "NODE_USE_ENV_PROXY=1 tsx src/tools/import-limitless.ts --top 32 --fill 0.7 582 581 580 579 578 577",
    "import-labs": "NODE_USE_ENV_PROXY=1 tsx src/tools/import-labs.ts 0072 0073 0074 0075 0076 0077",
    "meta": "tsx src/tools/meta.ts",
    "meta-matrix": "tsx src/tools/meta-matrix.ts",
    "web:data": "tsx src/tools/build-web-data.ts --private",
    "web:trainer": "tsx src/tools/trainer-positions.ts",
    "web:dev": "vite web",
    "web:build": "tsc -p web --noEmit && vite build web"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpannullo21-coder/ptcg-sim.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/fpannullo21-coder/ptcg-sim/issues"
  },
  "homepage": "https://github.com/fpannullo21-coder/ptcg-sim#readme",
  "devDependencies": {
    "@preact/preset-vite": "^2.9.1",
    "@types/node": "^22.10.2",
    "preact": "^10.24.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.8"
  },
  "private": true,
  "type": "module"
}